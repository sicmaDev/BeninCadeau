# Production — compléter uniquement sur le serveur, jamais dans Git
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://votre-domaine.tld
DATABASE_URL=mysql://utilisateur:mot_de_passe@127.0.0.1:3306/nom_base
JWT_SECRET=remplacer-par-une-valeur-aleatoire-longue
FEDAPAY_SECRET_KEY=remplacer-par-la-cle-secrete-de-production
SMTP_HOST=smtp.votre-fournisseur.tld
SMTP_PORT=587
SMTP_USER=votre-utilisateur-smtp
SMTP_PASS=votre-mot-de-passe-smtp
SMTP_FROM=noreply@votre-domaine.tld
ADMIN_EMAIL=admin@votre-domaine.tld
